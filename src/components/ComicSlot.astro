---
// The comic on the front page, framed like a printed cartoon: a ruled
// box, the panel, a caption, and the artist's credit. Leave out `comic`
// and it shows a placeholder frame instead.
import ComicFrame from './ComicFrame.astro';

interface Props {
  comic?: {
    href: string;
    title: string;
    /** The caption beneath the panel. */
    caption: string;
    image: string;
    imageAlt?: string;
    imageCredit?: string;
  };
}

const { comic } = Astro.props;
---

<section class="comic" aria-labelledby="comic-heading">
  <h2 id="comic-heading" class="comic__heading">The Comic</h2>

  {
    comic ? (
      <ComicFrame {...comic} />
    ) : (
      <div class="comic__frame comic__frame--empty">
        <p class="comic__placeholder">
          This space is reserved for a cartoon. The cartoonist has been located and is
          understood to be sharpening a pencil.
        </p>
      </div>
    )
  }
</section>

<style>
  .comic__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-label);
    font-size: var(--text-lg);
    letter-spacing: 0.12em;
    text-align: center;
  }

  /* The printed-cartoon frame: a thin line inside a thicker one. */
  .comic__frame {
    margin: 0;
    padding: var(--space-4);
    border: var(--rule-thick) double var(--rule);
    text-align: center;
  }

  .comic__frame--empty {
    display: grid;
    place-items: center;
    min-height: 14rem;
  }

  .comic__placeholder {
    max-width: 24rem;
    margin: 0;
    font-style: italic;
    color: var(--ink-soft);
  }
</style>
