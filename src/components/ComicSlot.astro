---
// The comic on the front page, framed like a printed cartoon: a ruled
// box, the panel, a caption, and the artist's credit. Leave out `comic`
// and it shows a placeholder frame instead.
import { Image } from 'astro:assets';
import { getIllustration, illustrationSrc } from '../lib/illustrations';

interface Props {
  comic?: {
    href: string;
    title: string;
    /** The caption beneath the panel. */
    caption: string;
    image: string;
    imageAlt?: string;
    imageCredit?: string;
  };
}

const { comic } = Astro.props;
const picture = comic ? getIllustration(comic.image) : undefined;
---

<section class="comic" aria-labelledby="comic-heading">
  <h2 id="comic-heading" class="comic__heading">The Comic</h2>

  {
    comic && picture ? (
      <figure class="comic__frame">
        <a class="comic__panel" href={comic.href}>
          <Image
            src={illustrationSrc(picture.file)}
            alt={comic.imageAlt ?? picture.alt}
            width={picture.width}
            height={picture.height}
            loading="lazy"
          />
        </a>
        <figcaption class="comic__caption">
          <span class="comic__title">{comic.title}</span>
          <span class="comic__text">{comic.caption}</span>
          <span class="fine-print comic__credit">{comic.imageCredit ?? picture.credit}</span>
        </figcaption>
      </figure>
    ) : (
      <div class="comic__frame comic__frame--empty">
        <p class="comic__placeholder">
          This space is reserved for a cartoon. The cartoonist has been located and is
          understood to be sharpening a pencil.
        </p>
      </div>
    )
  }
</section>

<style>
  .comic__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-label);
    font-size: var(--text-lg);
    letter-spacing: 0.12em;
    text-align: center;
  }

  /* The printed-cartoon frame: a thin line inside a thicker one. */
  .comic__frame {
    margin: 0;
    padding: var(--space-4);
    border: var(--rule-thick) double var(--rule);
    text-align: center;
  }

  .comic__panel {
    display: block;
  }

  .comic__panel img {
    width: min(100%, 28rem);
    margin-inline: auto;
    mix-blend-mode: multiply; /* a strip on white paper takes the page's colour */
  }

  .comic__caption {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .comic__title {
    font-family: var(--font-headline);
    font-size: var(--text-lg);
    font-weight: var(--weight-headline);
  }

  .comic__text {
    font-style: italic;
    color: var(--ink-soft);
  }

  .comic__frame--empty {
    display: grid;
    place-items: center;
    min-height: 14rem;
  }

  .comic__placeholder {
    max-width: 24rem;
    margin: 0;
    font-style: italic;
    color: var(--ink-soft);
  }
</style>
