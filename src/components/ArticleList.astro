---
// A run of article cards in columns divided by hairlines: one column on
// a phone, three on a desk. Used on the front page, the section fronts,
// and the "More from" strip under an article.
import ArticleCard from './ArticleCard.astro';
import { getIllustration } from '../lib/illustrations';

export interface ArticleListItem {
  href: string;
  title: string;
  dek: string;
  author: string;
  /** Shown above the headline where sections are mixed (the front page). */
  sectionName?: string;
  /** A file from public/illustrations, shown small above the headline. */
  image?: string;
  imageAlt?: string;
  /** Overrides the credit on record for that image. */
  imageCredit?: string;
}

interface Props {
  items: ArticleListItem[];
  /** Pass false when the page prints all its credits together itself. */
  showCredits?: boolean;
}

const { items, showCredits = true } = Astro.props;

// Every illustration must be credited on the page. A credit under each
// small picture would crowd the cards, so the credits are gathered,
// duplicates dropped, and printed once beneath the list.
const credits = [
  ...new Set(items.filter((i) => i.image).map((i) => i.imageCredit ?? getIllustration(i.image!).credit)),
];
---

<ul class="article-list">
  {
    items.map((item) => (
      <li class="article-list__item">
        <ArticleCard
          href={item.href}
          title={item.title}
          dek={item.dek}
          author={item.author}
          sectionName={item.sectionName}
          image={item.image}
          imageAlt={item.imageAlt}
        />
      </li>
    ))
  }
</ul>
{showCredits && credits.length > 0 && <p class="fine-print article-list__credits">Illustrations: {credits.join(' ')}</p>}

<style>
  .article-list__credits {
    margin: var(--space-5) 0 0;
    font-style: italic;
    text-align: center;
  }

  .article-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One column on a phone, with a hairline between items. */
  .article-list__item {
    padding-block: var(--space-4);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .article-list__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  /* Three across when there is room; the hairline moves between the
     columns. Every card gets the same padding either side so all three
     are exactly the same width (and their pictures the same height);
     the negative margin on the list lets the outer cards still line up
     with the edge of the page. :nth-child(3n + 1) is the first card of
     each row, and :nth-child(n + 4) is every card after the first row. */
  @media (min-width: 48rem) {
    .article-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--space-5);
      margin-inline: calc(-1 * var(--space-5));
    }

    .article-list__item {
      padding: 0 var(--space-5);
      border-top: 0;
      border-left: var(--rule-hair) solid var(--rule);
    }

    .article-list__item:nth-child(3n + 1) {
      border-left: 0;
    }

    .article-list__item:nth-child(n + 4) {
      padding-top: var(--space-5);
      border-top: var(--rule-hair) solid var(--rule);
    }
  }
</style>
