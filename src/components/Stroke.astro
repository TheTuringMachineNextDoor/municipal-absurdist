---
// The gliding stroke: a hand-drawn line that is drawn across a word when
// the pointer is over it. Put it inside the text it should cross, and
// put the class "has-stroke" on the link that triggers it. The colour
// comes from a --stroke custom property on any parent. The styles are in
// global.css under "Gliding stroke".
interface Props {
  /** Turn the line upside down, so neighbours do not all look alike. */
  flipped?: boolean;
}

const { flipped = false } = Astro.props;
---

<svg
  class:list={['stroke', { 'stroke--flipped': flipped }]}
  viewBox="0 0 100 12"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path d="M1.5 7.2 C0.4 6.4 0.8 5 2.6 4.6 C14 2.9 27 3.6 40 3.1 C56 2.5 73 2.2 97.5 3.4 C99.6 3.6 99.8 5.4 98.2 6.1 C96.4 6.9 94 6.3 91 6.4 C72 6.9 54 7.4 36 7.9 C25 8.2 13 9.4 4 8.9 C2.8 8.8 2 8 1.5 7.2 Z" />
</svg>
