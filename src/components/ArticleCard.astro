---
// A short notice of an article: a small illustration, headline, dek and
// byline. Sized to sit three to a row on the front page, the section
// fronts, and the "More from" strip.
import { Image } from 'astro:assets';
import { getIllustration, illustrationSrc } from '../lib/illustrations';

interface Props {
  href: string;
  title: string;
  dek: string;
  author: string;
  /** Shown above the headline where sections are mixed. */
  sectionName?: string;
  /** A file from public/illustrations. Its credit is printed once for
      the whole list, by ArticleList. */
  image?: string;
  imageAlt?: string;
}

const { href, title, dek, author, sectionName, image, imageAlt } = Astro.props;
const picture = image ? getIllustration(image) : undefined;
---

<article class="article-card">
  {
    picture && (
      // The picture is a second link to the same article. It is taken
      // out of the tab order and hidden from screen readers so the
      // article is not announced twice; the headline is the real link.
      <a class="article-card__picture" href={href} tabindex="-1" aria-hidden="true">
        <Image
          src={illustrationSrc(picture.file)}
          alt={imageAlt ?? picture.alt}
          width={picture.width}
          height={picture.height}
          loading="lazy"
        />
      </a>
    )
  }
  {sectionName && <p class="label label--accent article-card__section">{sectionName}</p>}
  <h3 class="article-card__title"><a href={href}>{title}</a></h3>
  <p class="article-card__dek">{dek}</p>
  <p class="label article-card__byline">By {author}</p>
</article>

<style>
  /* A square frame; the woodcut is fitted inside it whole, whatever its
     own proportions (object-fit: contain), and blended onto the paper. */
  .article-card__picture {
    display: block;
    width: min(100%, 11rem);
    aspect-ratio: 1;
    margin: 0 auto var(--space-3);
  }

  .article-card__picture img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .article-card__section {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
  }

  .article-card__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .article-card__title a {
    text-decoration: none;
  }

  .article-card__title a:hover {
    text-decoration: underline;
  }

  .article-card__dek {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

  .article-card__byline {
    margin: 0;
    font-size: var(--text-xs);
  }
</style>
