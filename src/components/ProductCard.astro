---
// One thing for sale, as shown on the Store's shelves: its picture in a
// frame, its title, who made it, the edition, the price, and whether it
// can be bought. The title links to the product's own page.
import { Image } from 'astro:assets';
import { getIllustration, illustrationSrc } from '../lib/illustrations';

interface Props {
  href: string;
  title: string;
  image: string;
  price: string;
  /** e.g. "Edition of 50". */
  edition?: string;
  artist?: { name: string; href: string };
  /** Who to name when there is no artist: "From the Archives". */
  maker?: string;
  /** Shown in place of the price's companion when it cannot be bought:
      "Sold Out", "Not Yet on Sale". */
  notice?: string;
}

const { href, title, image, price, edition, artist, maker = 'From the Archives', notice } = Astro.props;
const picture = getIllustration(image);
---

<article class="product-card">
  <!-- A second link to the same page; hidden from the tab order and
       from screen readers so the product is not announced twice. -->
  <a class="product-card__picture" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={illustrationSrc(picture.file)}
      alt={picture.alt}
      width={picture.width}
      height={picture.height}
      loading="lazy"
    />
  </a>
  <h3 class="product-card__title"><a href={href}>{title}</a></h3>
  <p class="label product-card__maker">
    {artist ? <>By <a href={artist.href}>{artist.name}</a></> : maker}
  </p>
  {edition && <p class="product-card__edition">{edition}</p>}
  <p class="product-card__price">
    <span>{price}</span>
    {notice && <span class="label product-card__notice">{notice}</span>}
  </p>
</article>

<style>
  .product-card {
    text-align: center;
  }

  /* The picture is shown whole, on a tinted mount inside a ruled frame,
     at the same height in every card so the rows line up. */
  .product-card__picture {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
    padding: var(--space-4);
    border: var(--rule-hair) solid var(--rule);
    background: color-mix(in srgb, var(--accent) 10%, var(--paper));
  }

  .product-card__picture img {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply; /* a white ground takes the mount's colour */
  }

  .product-card__title {
    margin-bottom: var(--space-1);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .product-card__title a {
    text-decoration: none;
  }

  .product-card__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .product-card__maker {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
  }

  .product-card__edition {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--ink-soft);
  }

  .product-card__price {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    font-family: var(--font-headline);
    font-size: var(--text-lg);
    font-variant-numeric: lining-nums;
  }

  .product-card__notice {
    font-size: var(--text-xs);
    color: var(--accent-text);
  }
</style>
