---
// The side column beside the lead story: a few recent headlines with
// their deks, separated by hairlines. Each has a small square thumbnail
// of its picture at the right, for a little colour down the column.
//
// Used for "Latest" on the front page and "Also in the Paper" on the
// section fronts.
import { Image } from 'astro:assets';
import { getIllustration, illustrationSrc } from '../lib/illustrations';

interface Props {
  items: {
    href: string;
    title: string;
    dek: string;
    sectionName: string;
    /** A file from public/illustrations, shown as the thumbnail. */
    image?: string;
    imageCredit?: string;
  }[];
  heading?: string;
}

const { items, heading = 'Latest' } = Astro.props;

// Every picture must be credited on the page. A credit under each tiny
// thumbnail would swamp it, so they are gathered and printed once, small,
// at the foot of the column.
const pictured = items.map((item) => ({ ...item, picture: item.image ? getIllustration(item.image) : undefined }));
const credits = [
  ...new Set(pictured.filter((item) => item.picture).map((item) => item.imageCredit ?? item.picture!.credit)),
];
---

<section class="latest-list" aria-labelledby="latest-list-heading">
  <h2 id="latest-list-heading" class="latest-list__heading">{heading}</h2>
  <ol class="latest-list__items">
    {
      pictured.map((item) => (
        <li class:list={['latest-list__item', { 'latest-list__item--pictured': item.picture }]}>
          <div>
            <p class="label label--accent latest-list__section">{item.sectionName}</p>
            <h3 class="latest-list__title"><a href={item.href}>{item.title}</a></h3>
            <p class="latest-list__dek">{item.dek}</p>
          </div>
          {item.picture && (
            // A second link to the same article, kept out of the tab order
            // and hidden from screen readers so the article is not
            // announced twice; the headline is the real link.
            <a class="latest-list__thumb" href={item.href} tabindex="-1" aria-hidden="true">
              <Image
                src={illustrationSrc(item.picture.file)}
                alt=""
                width={item.picture.width}
                height={item.picture.height}
                loading="lazy"
                style={item.picture.focus ? `object-position: ${item.picture.focus}` : undefined}
              />
            </a>
          )}
        </li>
      ))
    }
  </ol>
  {credits.length > 0 && <p class="fine-print latest-list__credits">Pictures: {credits.join(' ')}</p>}
</section>

<style>
  .latest-list__heading {
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-thick) double var(--rule);
    font-family: var(--font-label);
    font-size: var(--text-lg);
    letter-spacing: 0.12em;
  }

  .latest-list__items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .latest-list__item {
    padding-block: var(--space-4);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .latest-list__item:first-child {
    padding-top: var(--space-2);
    border-top: 0;
  }

  /* With a thumbnail: the words on the left, the picture on the right,
     both starting at the top. */
  .latest-list__item--pictured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem;
    gap: var(--space-3);
    align-items: start;
  }

  /* A small square, cropped from the middle-upper part of the picture
     (where faces usually are), in a hairline frame. */
  .latest-list__thumb {
    display: block;
    aspect-ratio: 1;
    margin-top: 0.2rem;
    border: var(--rule-hair) solid var(--rule);
  }

  .latest-list__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .latest-list__section {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
  }

  .latest-list__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .latest-list__title a {
    text-decoration: none;
  }

  .latest-list__title a:hover {
    text-decoration: underline;
  }

  .latest-list__dek {
    margin: 0;
    font-size: var(--text-sm);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

  .latest-list__credits {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-2);
    border-top: var(--rule-hair) solid var(--rule);
    font-style: italic;
  }
</style>
