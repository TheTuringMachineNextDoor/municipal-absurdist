---
// The side column beside the lead story: a few recent headlines with
// their deks, separated by hairlines. Each has a small square thumbnail
// of its picture at the right, for a little colour down the column.
//
// Used for "Latest" on the front page and "Also in the Paper" on the
// section fronts.
//
// On a wide screen the column sits beside the lead story, and if it were
// allowed its full length it would run on far below the lead, leaving a
// gap under the lead's picture. So there it is held to the lead's height
// and the list of headlines scrolls inside it. The page puts it in a box
// with `position: relative` (see the front page and SectionFront); this
// component then fills that box exactly. On a phone, where the column
// sits below the lead, it is simply as long as it needs to be.
import { Image } from 'astro:assets';
import { getIllustration, illustrationSrc } from '../lib/illustrations';

interface Props {
  items: {
    href: string;
    title: string;
    dek: string;
    sectionName: string;
    /** A file from public/illustrations, shown as the thumbnail. */
    image?: string;
  }[];
  heading?: string;
}

const { items, heading = 'Latest' } = Astro.props;

const pictured = items.map((item) => ({ ...item, picture: item.image ? getIllustration(item.image) : undefined }));
---

<section class="latest-list" aria-labelledby="latest-list-heading">
  <h2 id="latest-list-heading" class="latest-list__heading">{heading}</h2>
  <!-- tabindex="0" lets a keyboard reach the list, so it can be scrolled
       with the arrow keys when it scrolls; the label says what it is. -->
  <ol class="latest-list__items" tabindex="0" aria-labelledby="latest-list-heading">
    {
      pictured.map((item) => (
        <li class:list={['latest-list__item', { 'latest-list__item--pictured': item.picture }]}>
          <div>
            <p class="label label--accent latest-list__section">{item.sectionName}</p>
            <h3 class="latest-list__title"><a href={item.href}>{item.title}</a></h3>
            <p class="latest-list__dek">{item.dek}</p>
          </div>
          {item.picture && (
            // A second link to the same article, kept out of the tab order
            // and hidden from screen readers so the article is not
            // announced twice; the headline is the real link.
            <a class="latest-list__thumb" href={item.href} tabindex="-1" aria-hidden="true">
              <Image
                src={illustrationSrc(item.picture.file)}
                alt=""
                width={item.picture.width}
                height={item.picture.height}
                loading="lazy"
                style={item.picture.focus ? `object-position: ${item.picture.focus}` : undefined}
              />
            </a>
          )}
        </li>
      ))
    }
  </ol>
  <!-- Under the list when it scrolls (a wide screen, and more stories
       than fit): a small arrow saying there is more below. Pressing it
       brings the next story into view. The script hides it when there is
       nothing more to see. -->
  <button type="button" class="latest-list__more" data-latest-more hidden aria-label="Show the next story">
    <svg viewBox="0 0 16 10" width="16" height="10" aria-hidden="true" focusable="false">
      <path d="M1.5 1.5 L8 8 L14.5 1.5" />
    </svg>
  </button>
</section>

<script>
  // One arrow per column; there is at most one column on a page.
  for (const column of document.querySelectorAll<HTMLElement>('.latest-list')) {
    const list = column.querySelector<HTMLElement>('.latest-list__items')!;
    const arrow = column.querySelector<HTMLButtonElement>('[data-latest-more]')!;

    // Show the arrow only while some of the list is still hidden below.
    // (On a phone the list does not scroll, so this never shows there.)
    const update = () => {
      arrow.hidden = list.scrollTop + list.clientHeight >= list.scrollHeight - 4;
    };

    arrow.addEventListener('click', () => {
      // Scroll so that the first story still partly hidden comes into view.
      const bottom = list.scrollTop + list.clientHeight;
      const next = [...list.children].find(
        (item) => (item as HTMLElement).offsetTop + (item as HTMLElement).offsetHeight > bottom + 2,
      ) as HTMLElement | undefined;
      list.scrollTo({ top: next ? next.offsetTop - list.offsetTop : list.scrollHeight, behavior: 'smooth' });
    });

    list.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .latest-list__heading {
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-thick) double var(--rule);
    font-family: var(--font-label);
    font-size: var(--text-lg);
    letter-spacing: 0.12em;
  }

  .latest-list__items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .latest-list__items:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* Beside the lead: fill the box the page gives us (as tall as the
     lead), the heading fixed at the top and the arrow at the foot, the headlines between them
     scrolling. `position: absolute` with `inset: 0` makes the column
     take its size from the box rather than from its own contents, which
     is what stops it stretching the row. */
  @media (min-width: 60rem) {
    .latest-list {
      position: absolute;
      inset: 0;
      /* A box placed this way ignores its container's padding, so take
         the container's own: it keeps the gap beside the column rule. */
      padding-left: inherit;
      display: flex;
      flex-direction: column;
    }

    .latest-list__items {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding-right: var(--space-3); /* room for the scroll bar */
      /* A thin scroll bar in the rule colour, where the browser allows. */
      scrollbar-width: thin;
      scrollbar-color: var(--rule) transparent;
    }

    /* The arrow under the list: small, centred, on a hairline. */
    .latest-list__more {
      flex: none;
      display: grid;
      place-items: center;
      width: 100%;
      height: 1.75rem;
      padding: 0;
      border: 0;
      border-top: var(--rule-hair) solid var(--rule);
      background: none;
      color: var(--ink-soft);
      cursor: pointer;
    }

    .latest-list__more[hidden] {
      display: none;
    }

    .latest-list__more svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform 150ms;
    }

    .latest-list__more:hover {
      color: var(--accent-text);
    }

    .latest-list__more:hover svg {
      transform: translateY(2px);
    }
  }

  .latest-list__item {
    padding-block: var(--space-4);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .latest-list__item:first-child {
    padding-top: var(--space-2);
    border-top: 0;
  }

  /* With a thumbnail: the words on the left, the picture on the right,
     centred top to bottom against the words beside it. */
  .latest-list__item--pictured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem;
    gap: var(--space-3);
    align-items: start;
  }

  /* A small square, cropped from the middle-upper part of the picture
     (where faces usually are), in a hairline frame. */
  .latest-list__thumb {
    display: block;
    align-self: center;
    aspect-ratio: 1;
    border: var(--rule-hair) solid var(--rule);
  }

  .latest-list__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .latest-list__section {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
  }

  .latest-list__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .latest-list__title a {
    text-decoration: none;
  }

  .latest-list__title a:hover {
    text-decoration: underline;
  }

  .latest-list__dek {
    margin: 0;
    font-size: var(--text-sm);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

</style>
