---
// A small top hat, worn by the nameplate. Decorative, so it is hidden
// from screen readers. Drawn inline so the lines take the ink colour
// from CSS (currentColor). Same drawing as placeholder-top-hat.svg,
// without the white backing or the ground shadow.
---

<svg class="top-hat" viewBox="60 42 280 208" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <!-- crown -->
    <path d="M138 196 C134 150 132 104 136 62" />
    <path d="M262 196 C266 150 268 104 264 62" />
    <ellipse cx="200" cy="62" rx="64" ry="14" />
    <!-- band -->
    <path d="M137 168 C160 180 240 180 263 168" />
    <path d="M138 190 C160 203 240 203 262 190" />
    <!-- brim -->
    <path d="M138 196 C104 196 66 204 66 216 C66 234 134 244 200 244 C266 244 334 234 334 216 C334 204 296 196 262 196" />
  </g>
  <!-- hatching: shade on the right of the crown, and the band -->
  <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
    <path d="M250 84 V160 M240 86 V164 M230 88 V166 M220 89 V167" />
    <path d="M148 172 l8 14 M164 177 l8 14 M180 179 l8 14 M196 180 l8 14 M212 179 l8 14 M228 177 l8 14 M244 173 l8 14" />
  </g>
</svg>

<style>
  .top-hat {
    display: block;
    width: 100%;
    height: auto;
    color: var(--ink);
  }
</style>
