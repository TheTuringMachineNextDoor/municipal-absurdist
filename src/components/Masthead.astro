---
// The nameplate: "The Municipal Absurdist" in Nova Cut, under a small top hat,
// the slogan beneath it, and the dateline bar.
//
// `as` chooses the wrapping tag. The front page passes "h1" because there
// the paper's name is the page's main heading; every other page has its
// own h1 (the headline), so the masthead is a plain <p>.

import TopHat from './TopHat.astro';
import Stroke from './Stroke.astro';
import MarkerStroke from './MarkerStroke.astro';

interface Props {
  as?: 'h1' | 'p';
}

const { as: Tag = 'p' } = Astro.props;

const dateOptions: Intl.DateTimeFormatOptions = {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};

// This runs when the site is BUILT, not when a reader opens it. The
// script at the bottom corrects it in the browser.
const built = new Date();
const builtLabel = built.toLocaleDateString('en-US', dateOptions);
const builtIso = built.toISOString().slice(0, 10);
---

<header class="masthead sheet">
  <!-- The top of the masthead: the nameplate in the middle and, on a
       wide screen, an "ear" either side of it. Ears are the small boxed
       notices beside a newspaper's name. They are written after the
       nameplate here, so that a screen reader meets the paper's name
       first; CSS places them left and right. -->
  <div class="masthead__top">
  <div class="masthead__plate">
  <div class="masthead__hat"><TopHat /></div>
  <Tag class="masthead__name">
    <!-- Plain text in a link: sighted readers and screen readers get
         the same thing, once. -->
    <!-- The yellow line glides across the name on hover or press. It is
         not kept after the click: the front page loads with it gone. -->
    <a class="masthead__link has-stroke" href="/">The Municipal Absurdist<Stroke /></a>
  </Tag>
  <p class="masthead__slogan">The world, as it unfortunately is</p>
  </div>

  <aside class="ear ear--left" aria-labelledby="ear-support">
    <p id="ear-support" class="ear__title">Support the Paper</p>
    <p class="ear__text">
      No owner and no advertisers. It is paid for by its readers, when it is paid for at all.
    </p>
    <p class="ear__link"><a href="/support">Keep the presses warm</a></p>
  </aside>

  <aside class="ear ear--right" aria-labelledby="ear-wanted">
    <p id="ear-wanted" class="ear__title">Writers &amp; Artists Wanted</p>
    <p class="ear__text">
      The paper is short of both. Reports, cartoons and curiosities are read by an editor and printed under your
      name.
    </p>
    <p class="ear__link"><a href="/submit">Submit your work</a></p>
  </aside>
  </div>

  <div class="dateline label">
    <!-- For a signed-in reader the script at the foot of this file
         swaps these two for a single "My Account". -->
    <span class="dateline__item dateline__item--start dateline__account" data-account-links>
      <a class="dateline__button" href="/login" data-account-out>Log In</a>
      <a class="dateline__button dateline__button--outlined" href="/signup" data-account-out>Sign Up</a>
      <a class="dateline__button dateline__button--outlined" href="/account" data-account-in hidden>My Account</a>
      <!-- For an administrator. The aria-label is the link's whole name
           for a screen reader, in place of the two pieces of text. -->
      <a
        class="dateline__button dateline__chief has-marker"
        href="/account"
        aria-label="Editor-in-Chief (admin account)"
        data-account-chief
        hidden
      >
        <MarkerStroke />
        <span class="dateline__chief-text">Editor-in-Chief</span>
        <span class="dateline__admin">Admin</span>
      </a>
    </span>
    <time class="dateline__item" datetime={builtIso} data-dateline>{builtLabel}</time>
    <!-- The clock. The dashes show for an instant, or for good if the
         reader has scripts switched off. -->
    <time class="dateline__item dateline__item--end dateline__clock" data-clock>--:--:--</time>
  </div>
</header>

<!-- A static site is built once and served as-is, so the date above is
     the date of the last deploy. These few lines swap in the reader's own
     date. `is:inline` tells Astro to leave the script exactly here. -->
<script is:inline>
  (function () {
    var el = document.querySelector('[data-dateline]');
    if (!el) return;
    var now = new Date();
    el.textContent = now.toLocaleDateString('en-US', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
    var pad = function (n) { return String(n).padStart(2, '0'); };
    el.setAttribute('datetime', now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()));

    // The ticking clock: hours, minutes and seconds on the reader's own
    // watch, redrawn once a second.
    var clock = document.querySelector('[data-clock]');
    if (!clock) return;
    var tick = function () {
      var t = new Date();
      clock.textContent = t.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', second: '2-digit' });
      clock.setAttribute('datetime', pad(t.getHours()) + ':' + pad(t.getMinutes()) + ':' + pad(t.getSeconds()));
    };
    tick();
    setInterval(tick, 1000);
  })();
</script>

<!-- Signed in? Then "Log In / Sign Up" becomes "My Account". The check
     reads the browser's storage only; it does not download the accounts
     library, so it costs readers nothing. -->
<script>
  import { currentProfile, looksSignedIn, rememberedRole } from '../lib/accounts';

  const links = document.querySelector<HTMLElement>('[data-account-links]');
  if (links && looksSignedIn()) {
    const show = (hook: 'in' | 'chief') => {
      for (const link of links.querySelectorAll<HTMLElement>('a')) link.hidden = true;
      links.querySelector<HTMLElement>(`[data-account-${hook}]`)!.hidden = false;
    };

    // An administrator is shown "Editor-in-Chief". The role is read from
    // what the browser remembers, so this is instant. It is a label
    // only: what an administrator may do is enforced by the database.
    const role = rememberedRole();
    show(role === 'admin' ? 'chief' : 'in');

    // Not remembered yet in this browser (a first visit after signing
    // in): ask the database once. This is the only time the masthead
    // downloads the accounts library.
    if (role === null) {
      currentProfile().then((profile) => {
        if (profile?.is_admin) show('chief');
      });
    }
  }
</script>

<style>
  .masthead {
    padding-top: var(--space-7);
    text-align: center;
  }

  /* ---- The ears ----
     Hidden until the screen is wide enough to hold them beside the
     name (72rem, about 1150 pixels). Below that there is no room, and
     both pages are in the menu. */
  .ear {
    display: none;
  }

  @media (min-width: 72rem) {
    /* Three columns: ear, nameplate, ear. `grid-template-areas` names
       the places, so each part can be put in its place whatever order
       it is written in. */
    .masthead__top {
      display: grid;
      grid-template-columns: 13rem minmax(0, 1fr) 13rem;
      grid-template-areas: 'left plate right';
      align-items: center;
      gap: var(--space-4);
    }

    .masthead__plate { grid-area: plate; }
    .ear--left { grid-area: left; }
    .ear--right { grid-area: right; }

    /* With an ear either side there is less room for the name, so here
       it is sized to fit the space between them. The name is about 11.7
       times its font-size wide. The space is the window's width less
       the two ears, the gaps and the page's side margins, which come to
       about 34rem; dividing what is left by 11.9 gives a size that
       always fits, and 4.75rem is still the most it grows to. */
    .masthead__top .masthead__link {
      font-size: min(4.75rem, calc((min(100vw, var(--page-max)) - 34rem) / 11.9));
    }

    /* An ear: a small double-ruled box, like a classified notice. */
    /* Both ears are stretched to the full height of the row, so the two
       boxes are always the same size however much each has to say. The
       words inside are centred top to bottom. */
    .ear {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-self: stretch;
      padding: var(--space-3);
      border: var(--rule-thick) double var(--rule);
      text-align: center;
    }

    .ear__title {
      margin: 0 0 var(--space-2);
      padding-bottom: var(--space-2);
      border-bottom: var(--rule-hair) solid var(--rule);
      font-family: var(--font-label);
      font-size: var(--text-sm);
      font-weight: 700;
      letter-spacing: 0.1em;
      line-height: 1.25;
    }

    .ear__text {
      margin: 0 0 var(--space-2);
      font-size: var(--text-xs);
      font-style: italic;
      line-height: 1.35;
      color: var(--ink-soft);
    }

    .ear__link {
      margin: 0;
      font-family: var(--font-label);
      font-size: var(--text-xs);
      letter-spacing: 0.08em;
    }

    .ear__link a {
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }
  }

  /* The hat sits centred just above the name. */
  .masthead__hat {
    width: clamp(2.5rem, 7vw, 4rem);
    margin: 0 auto var(--space-1);
  }

  .masthead__name {
    margin: 0;
    font-weight: 400;
    line-height: 1;
  }

  /* The name is sized by the width of the window (vw) so that it stays
     on one line: it is about 11.7 times its font-size wide, so 6.8vw sits
     comfortably inside a phone and the clamp stops it at 4.75rem. */
  .masthead__link {
    position: relative;      /* the stroke is placed against the name */
    display: inline-block;
    --stroke: var(--accent);
    --stroke-height: 0.4em;  /* the name is large; keep the line slim */
    font-family: var(--font-masthead);
    font-size: clamp(1.375rem, 6.8vw, 4.75rem);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .masthead__link:hover {
    color: var(--ink);
  }

  .masthead__slogan {
    margin: var(--space-2) 0 var(--space-2);
    font-size: clamp(1.25rem, 1.05rem + 1vw, 1.75rem);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

  /* The dateline bar: small caps between two thin rules. */
  .dateline {
    display: grid;
    align-items: center;
    grid-template-columns: 1fr;
    gap: 0 var(--space-4);
    margin-top: var(--space-3);
    padding-block: var(--space-2);
    border-block: var(--rule-hair) solid var(--rule);
    color: var(--ink);
    font-size: var(--text-xs);
  }

  /* Every digit the same width, so the clock does not shiver as it ticks. */
  .dateline__clock {
    font-variant-numeric: tabular-nums lining-nums;
  }

  .dateline__button[hidden] {
    display: none;
  }

  /* The administrator's link: ink on the highlighter, with a small
     "Admin" tag after the title. The marker stroke itself is styled in
     global.css. The text sits above the stroke (z-index) so that it is
     the stroke that is blended into the paper, not the letters. */
  .dateline__chief {
    color: var(--ink);
  }

  .dateline__chief-text,
  .dateline__admin {
    position: relative;
  }

  .dateline__admin {
    margin-left: 0.4em;
    padding: 0 0.35em;
    border: var(--rule-hair) solid currentColor;
    font-size: 0.72em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .dateline__account {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  /* Quiet buttons: small caps, square, and for Sign Up a hairline box. */
  .dateline__button {
    padding: 0.1em 0.6em;
    border: var(--rule-hair) solid transparent;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .dateline__button--outlined {
    border-color: var(--ink-soft);
  }

  .dateline__button:hover {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }

  @media (min-width: 40rem) {
    .dateline__account {
      justify-content: flex-start;
      margin-bottom: 0;
    }

    .dateline {
      grid-template-columns: 1fr auto 1fr;
      font-size: var(--text-sm);
    }

    .dateline__item--start { text-align: left; }
    .dateline__item--end { text-align: right; }
  }
</style>
