---
// The lead story of the front page: a big picture, then the section
// label, a large headline that links to the article, the dek, and the
// byline. It fills whatever column it is put in.
import Illustration from './Illustration.astro';
import { formatDate } from '../lib/articles';
import { getIllustration, isPortrait } from '../lib/illustrations';

interface Props {
  href: string;
  title: string;
  dek: string;
  author: string;
  date: Date;
  image: string;
  imageAlt?: string;
  imageCredit?: string;
  /** Shown above the headline; leave out on a section's own page. */
  sectionName?: string;
  sectionHref?: string;
  /** Set the headline over yellow marker strokes. */
  highlighted?: boolean;
}

const { href, title, dek, author, date, image, imageAlt, imageCredit, sectionName, sectionHref, highlighted = false } =
  Astro.props;
const { label, iso } = formatDate(date);

// A landscape picture sits above the headline. An upright one would be
// cropped to a forehead up there, so it stands beside the words instead.
const upright = isPortrait(getIllustration(image));
---

<article class:list={['lead', { 'lead--upright': upright }]}>
  <div class="lead__picture">
    <Illustration file={image} alt={imageAlt} credit={imageCredit} variant="lead" />
  </div>

  <div class="lead__text">
    {
      sectionName && (
        <p class="label label--accent lead__section">
          {sectionHref ? <a href={sectionHref}>{sectionName}</a> : sectionName}
        </p>
      )
    }
    <h2 class:list={['lead__title', { 'lead__title--highlighted': highlighted }]}>
      <a href={href}>{highlighted ? <span class="highlighter">{title}</span> : title}</a>
    </h2>
    <p class="dek lead__dek">{dek}</p>
    <p class="label lead__byline">
      By {author} <span aria-hidden="true">&middot;</span> <time datetime={iso}>{label}</time>
    </p>
    <p class="lead__more"><a href={href}>Read the full report</a></p>
  </div>
</article>

<style>
  .lead {
    display: grid;
    gap: var(--space-4);
  }

  /* The lead figure brings its own margins and width limits for an
     article page. Here it fills the column, and an upright picture is
     cropped to a landscape frame so it does not push the headline off
     the screen. */
  .lead__picture :global(.illustration) {
    margin: 0;
    text-align: left;
  }

  .lead__picture :global(.illustration img) {
    width: 100%;
  }

  /* Upright picture: beside the words once there is room for both. */
  @media (min-width: 40rem) {
    .lead--upright {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: var(--space-6);
    }

    .lead--upright .lead__title {
      font-size: var(--text-h2);
    }
  }

  .lead__picture :global(.illustration figcaption) {
    max-width: none;
    margin-inline: 0;
  }

  .lead__section a,
  .lead__title a {
    text-decoration: none;
  }

  .lead__section {
    margin-bottom: var(--space-3);
  }

  .lead__title {
    font-size: var(--text-h1);
  }

  .lead__title a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  /* Room between lines so one marker stroke does not run into the next. */
  .lead__title--highlighted {
    line-height: 1.4;
  }

  .lead__dek {
    max-width: 44rem;
    font-size: var(--text-h4);
  }

  .lead__byline {
    margin-bottom: var(--space-3);
  }

  .lead__more {
    margin: 0;
    font-style: italic;
  }
</style>
