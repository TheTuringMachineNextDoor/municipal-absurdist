---
// The text of an article: one readable column, a drop cap on the first
// paragraph, pull quotes, and inline illustrations with their credits.
//
// It takes the HTML rendered from the article's Markdown. In Markdown:
//   a line starting with ">"                     becomes a pull quote
//   ![description](/illustrations/file.webp)     becomes an illustration
import { renderArticleBody } from '../lib/article-body';

interface Props {
  html: string;
}

const body = renderArticleBody(Astro.props.html);
---

<div class="article-body" set:html={body} />

<!-- `is:global` because the paragraphs inside come from Markdown, and
     Astro's usual scoped styles only reach elements written in this file.
     Every rule starts with .article-body, so nothing leaks out. -->
<style is:global>
  .article-body {
    max-width: var(--measure-article);
    margin-inline: auto;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .article-body p {
    margin-bottom: var(--space-5);
    text-wrap: pretty;
  }

  /* The drop cap: the same recipe as .drop-cap in global.css, applied to
     the opening paragraph without the writer having to ask for it. */
  .article-body > p:first-of-type::first-letter {
    float: left;
    margin: 0.05em 0.08em 0 0;
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    font-size: 5.4em;
    line-height: 0.8;
    color: var(--ink);
  }

  /* Crossheads inside an article are small-cap labels, not headlines. */
  .article-body h2,
  .article-body h3 {
    margin: var(--space-6) 0 var(--space-3);
    font-family: var(--font-label);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: var(--leading-snug);
  }

  /* Pull quote: large italic between two rules. */
  .article-body blockquote {
    clear: both;
    margin: var(--space-6) 0;
    padding: var(--space-5) var(--space-2);
    border: 0;
    border-block: var(--rule-thick) double var(--rule);
    font-size: var(--text-h4);
    font-style: italic;
    line-height: var(--leading-snug);
    text-align: center;
    text-wrap: balance;
  }

  .article-body blockquote p {
    margin: 0;
  }

  /* A second paragraph in a pull quote is its attribution. */
  .article-body blockquote p + p {
    margin-top: var(--space-3);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-style: normal;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .article-body .illustration--inline {
    clear: both;
    margin-block: var(--space-6);
  }
</style>
