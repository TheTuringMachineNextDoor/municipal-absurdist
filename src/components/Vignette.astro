---
// PLACEHOLDER. The centre of the masthead: "Municipal" arched over a
// small engraving, after The Orange Post (1908). The town hall below is a
// stand-in until the artist delivers the real vignette; replace the
// <g class="vignette__art"> group and keep the arch.
//
// It is drawn as inline SVG so the lines take the ink colour from CSS
// (currentColor) and the arched word can use the same web font as the
// rest of the nameplate. Everything is aria-hidden: the masthead supplies
// the publication's name to screen readers as ordinary text.
---

<svg class="vignette" viewBox="0 0 200 180" aria-hidden="true" focusable="false">
  <defs>
    <path id="vignette-arch" d="M 22 78 A 82 66 0 0 1 178 78" />
  </defs>

  <text class="vignette__word" text-anchor="middle">
    <textPath href="#vignette-arch" startOffset="50%">Municipal</textPath>
  </text>

  <g class="vignette__art" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <!-- rays behind the dome -->
    <g stroke-width="1">
      <path d="M100 62 V52 M84 66 l-6 -9 M116 66 l6 -9 M71 76 l-9 -6 M129 76 l9 -6 M64 90 l-10 -3 M136 90 l10 -3" />
    </g>
    <!-- finial, lantern and dome -->
    <path d="M100 66 v8 M96 74 h8 v7 h-8 z" />
    <path d="M78 104 a22 23 0 0 1 44 0" />
    <path d="M84 104 a16 20 0 0 1 8 -19 M116 104 a16 20 0 0 0 -8 -19 M100 81 v23" stroke-width="1" />
    <!-- drum and pediment -->
    <path d="M74 104 h52 v7 h-52 z" />
    <path d="M56 124 L100 111 L144 124 z" />
    <!-- entablature, columns, steps -->
    <path d="M58 124 h84 v6 h-84 z" />
    <path d="M66 130 v26 M72 130 v26 M84 130 v26 M90 130 v26 M110 130 v26 M116 130 v26 M128 130 v26 M134 130 v26" />
    <path d="M96 156 v-17 a4 4 0 0 1 8 0 v17" />
    <path d="M56 156 h88 M50 162 h100 M44 168 h112" />
    <!-- ground hatching -->
    <path d="M30 174 h140 M40 178 h34 M88 178 h52 M150 178 h14" stroke-width="1" />
  </g>
</svg>

<style>
  .vignette {
    display: block;
    width: 100%;
    height: auto;
    color: var(--ink);
    overflow: visible;
  }

  .vignette__word {
    font-family: var(--font-masthead);
    font-size: 34px; /* in SVG units: scales with the drawing */
    fill: currentColor;
    letter-spacing: 1px;
  }
</style>
