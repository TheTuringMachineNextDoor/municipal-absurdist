---
// Section navigation, in small caps beneath the dateline.
import { sections } from '../data/sections';
import Stroke from './Stroke.astro';

// Astro.url.pathname is the page being built, e.g. "/politics/some-story".
// Its first segment tells us which section to mark as current.
const current = Astro.url.pathname.split('/').filter(Boolean)[0];

// The Store sits after the sections in the nav but is not a section:
// articles cannot be filed under it, so it stays out of sections.ts.
const links = [...sections, { slug: 'store', name: 'Store', ink: '#8A4B2A' }]; // russet

// The rest live behind the menu button.
const morePages = [
  { href: '/about', name: 'About', ink: '#2A4A7B' },     // ink blue
  { href: '/contact', name: 'Contact', ink: '#A8321F' }, // vermilion
  { href: '/archive', name: 'Archive', ink: '#B8862B' }, // ochre
];
---

<nav class="section-nav sheet" aria-label="Main">
  <ul class="section-nav__list">
    {
      links.map((section, index) => (
        <li>
          <a
            class="section-nav__link has-stroke"
            href={`/${section.slug}`}
            aria-current={current === section.slug ? 'page' : undefined}
            style={`--stroke: ${section.ink}`}
          >
            {section.name}
            <Stroke flipped={index % 2 === 1} />
          </a>
        </li>
      ))
    }
    <li class="section-nav__more">
      <!-- <details> is the browser's own show/hide element: clicking the
           <summary> opens it, with no script needed and with keyboard
           and screen-reader support built in. -->
      <details class="more-menu" data-more-menu>
        <summary class="more-menu__button">
          <span class="visually-hidden">More pages</span>
          <svg viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" focusable="false">
            <path d="M0 1 H20 M0 7 H20 M0 13 H20" stroke="currentColor" stroke-width="1.5" fill="none" />
          </svg>
        </summary>
        <ul class="more-menu__list">
          {
            morePages.map((page, index) => (
              <li class="more-menu__item" style={`--i: ${index}`}>
                <a
                  class="more-menu__link has-stroke"
                  href={page.href}
                  aria-current={`/${current}` === page.href ? 'page' : undefined}
                  style={`--stroke: ${page.ink}`}
                >
                  <span class="stroke-text">
                    {page.name}
                    <Stroke flipped={index % 2 === 1} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </li>
  </ul>
</nav>

<!-- <details> opens and shuts instantly by itself. These lines let it
     close gracefully: play the roll-up animation first, then shut. They
     also close it on Escape or a click anywhere else, as a menu should. -->
<script is:inline>
  (function () {
    var menu = document.querySelector('[data-more-menu]');
    if (!menu) return;
    var summary = menu.querySelector('summary');
    var still = window.matchMedia('(prefers-reduced-motion: reduce)');

    var close = function () {
      if (!menu.open || menu.classList.contains('is-closing')) return;
      if (still.matches) { menu.open = false; return; }
      menu.classList.add('is-closing');
      setTimeout(function () {
        menu.open = false;
        menu.classList.remove('is-closing');
      }, 200); // the length of the roll-up animation in the CSS below
    };

    summary.addEventListener('click', function (event) {
      if (menu.open) { event.preventDefault(); close(); }
    });
    document.addEventListener('click', function (event) {
      if (!menu.contains(event.target)) close();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && menu.open) { close(); summary.focus(); }
    });
  })();
</script>

<style>
  .section-nav__list {
    position: relative; /* the menu panel is placed against this on a phone */
    display: flex;
    align-items: center;
    flex-wrap: wrap; /* six sections do not fit one line on a phone; let them fall to two */
    justify-content: center;
    gap: 0 var(--space-5);
    margin: 0;
    padding: var(--space-1) 0;
    list-style: none;
    border-bottom: var(--rule-thick) double var(--rule);
  }

  .section-nav__link {
    display: block;
    /* Generous vertical padding makes a comfortable target for a thumb. */
    padding: var(--space-2) 0;
    font-family: var(--font-label);
    font-size: var(--text-base);
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  /* The gliding stroke is styled in global.css; the link only has to
     be the thing the line is placed against. */
  .section-nav__link {
    position: relative;
  }

  .section-nav__link:hover {
    color: var(--ink);
  }

  /* The menu button: three bars, with a thumb-sized target. */
  .more-menu__button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    cursor: pointer;
    list-style: none; /* removes the default disclosure triangle */
  }

  .more-menu__button::-webkit-details-marker {
    display: none;
  }

  .more-menu__button:hover,
  .more-menu[open] .more-menu__button {
    color: var(--accent);
  }

  /* The panel: paper, a hairline box, no shadow. On a phone it spans the
     nav; on a wider screen it hangs from the button's right edge. */
  .more-menu__list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 5;
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
    background: var(--paper);
    border: var(--rule-hair) solid var(--rule);
    text-align: center;
  }

  .more-menu__link {
    display: block;
    padding: var(--space-2) var(--space-5);
    font-family: var(--font-label);
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .more-menu__link:hover {
    color: var(--ink);
  }

  /* Opening: the panel unrolls downward from the rule, like a blind,
     and the three links rise into place one after another (--i is each
     link's position in the list, set in the markup). */
  .more-menu[open] .more-menu__list {
    animation: more-menu-unroll 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .more-menu[open] .more-menu__item {
    animation: more-menu-rise 380ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(90ms + var(--i) * 60ms);
  }

  /* Closing: the script adds .is-closing, waits for the panel to roll
     back up, and only then shuts the <details>. */
  .more-menu.is-closing .more-menu__list {
    animation: more-menu-rollup 200ms cubic-bezier(0.55, 0, 0.8, 0.4) both;
  }

  .more-menu.is-closing .more-menu__item {
    animation: none;
  }

  @keyframes more-menu-unroll {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0); }
  }

  @keyframes more-menu-rollup {
    from { clip-path: inset(0); }
    to { clip-path: inset(0 0 100% 0); }
  }

  @keyframes more-menu-rise {
    from { opacity: 0; transform: translateY(0.6em); }
    to { opacity: 1; transform: none; }
  }

  @media (min-width: 40rem) {
    .section-nav__list {
      gap: 0 var(--space-6);
    }

    .section-nav__more {
      position: relative;
    }

    .more-menu__list {
      left: auto;
      min-width: 11rem;
      text-align: left;
    }
  }
</style>
