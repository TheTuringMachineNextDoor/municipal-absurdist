---
// /signup. The same form as /login: with no passwords, joining and
// returning are the same act. See LoginForm.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import AccountsNotice from '../components/AccountsNotice.astro';
import LoginForm from '../components/LoginForm.astro';
import { accountsConfigured } from '../lib/accounts';
---

<BaseLayout title="Sign Up" noindex>
  {
    accountsConfigured ? (
      <LoginForm
        heading="Sign Up"
        dek="Enter your name in the register. It costs nothing, and the register is not shown to anyone."
      />
    ) : (
      <AccountsNotice heading="Sign Up" />
    )
  }
</BaseLayout>
