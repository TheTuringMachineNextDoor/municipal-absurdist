---
// /login. While accounts are switched off (no Supabase details in
// src/data/site.ts) this shows a holding notice instead of the form.
import BaseLayout from '../layouts/BaseLayout.astro';
import AccountsNotice from '../components/AccountsNotice.astro';
import LoginForm from '../components/LoginForm.astro';
import { accountsConfigured } from '../lib/accounts';
---

<BaseLayout title="Log In" noindex>
  {
    accountsConfigured ? (
      <LoginForm mode="login" heading="Log In" dek="State your name and business. The clerk will check both against the register." />
    ) : (
      <AccountsNotice heading="Log In" />
    )
  }
</BaseLayout>
