---
// The front page. Laid out like a newspaper's, not a blog feed:
//
//   lead story (two-thirds)      | latest headlines (one-third)
//   a band for each section that has stories
//   the comic (two-thirds)       | recurring features (one-third)
//   the newsletter box
//
// The parts are written below in the order a phone shows them (lead,
// latest, features, comic, sections, newsletter). On a wide screen CSS
// grid moves them into the arrangement above; see the styles.
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import LatestList from '../components/LatestList.astro';
import SectionBand from '../components/SectionBand.astro';
import ComicSlot from '../components/ComicSlot.astro';
import FeaturesStrip from '../components/FeaturesStrip.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { sections } from '../data/sections';
import { getPublishedArticles, summarize } from '../lib/articles';

const all = await getPublishedArticles(); // newest first

// Comics have their own slot, so they stay out of the news columns.
const comics = all.filter((a) => a.data.section === 'comic');
const news = all.filter((a) => a.data.section !== 'comic');

// The lead is the newest article marked "featured"; failing that, the
// newest article of any kind.
const leadArticle = news.find((a) => a.data.featured) ?? news[0];
const lead = leadArticle && (await summarize(leadArticle));
const others = await Promise.all(news.filter((a) => a !== leadArticle).map(summarize));

// The side column: the four newest after the lead.
const latest = others.slice(0, 4);

// A band for each section with anything in it (the lead aside), in
// masthead order, three stories at most.
const bands = sections
  .filter((section) => section.slug !== 'comic')
  .map((section) => ({
    section,
    items: others
      .filter((o) => o.sectionHref === `/${section.slug}`)
      .slice(0, 3)
      .map(({ sectionName, sectionHref, date, ...card }) => card),
  }))
  .filter((band) => band.items.length > 0);

const comicArticle = comics[0];
const comic = comicArticle && (await summarize(comicArticle));

---

<BaseLayout mastheadAs="h1">
  {
    lead ? (
      <div class="front">
        <div class="front__lead">
          <LeadStory {...lead} highlighted />
        </div>

        {latest.length > 0 && (
          <div class="front__latest">
            <LatestList items={latest} />
          </div>
        )}

        <div class="front__features">
          <FeaturesStrip />
        </div>

        <div class="front__comic">
          <ComicSlot
            comic={
              comic && {
                href: comic.href,
                title: comic.title,
                caption: comic.dek,
                image: comic.image,
                imageAlt: comic.imageAlt,
                imageCredit: comic.imageCredit,
              }
            }
          />
        </div>

        {bands.length > 0 && (
          <div class="front__sections">
            {bands.map((band) => (
              <SectionBand name={band.section.name} href={`/${band.section.slug}`} items={band.items} />
            ))}
          </div>
        )}

        <div class="front__newsletter">
          <NewsletterBox />
        </div>
      </div>
    ) : (
      <p class="edition-empty">
        The first edition is delayed by circumstances entirely within our control. The
        presses are warm, and the news has been asked to wait in the corridor.
      </p>
    )
  }
</BaseLayout>

<style>
  /* A phone: one column, in the order the parts are written above. */
  .front {
    display: grid;
    gap: var(--space-6);
  }

  /* minmax(0, ...) on the columns and min-width: 0 here let a column
     shrink below the width of its widest word or picture, which is what
     stops a grid from pushing the page sideways. */
  .front > * {
    min-width: 0;
  }


  /* A desk: two-thirds and one-third, with named areas. Each part is
     assigned to its area whatever order it was written in. */
  @media (min-width: 60rem) {
    .front {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      grid-template-areas:
        'lead     latest'
        'sections sections'
        'comic    features'
        'news     news';
      column-gap: var(--space-6);
      row-gap: var(--space-7);
    }

    .front__lead { grid-area: lead; }
    .front__sections { grid-area: sections; }
    .front__comic { grid-area: comic; }
    .front__newsletter { grid-area: news; }

    /* The narrow column takes a hairline down its left side. */
    .front__latest,
    .front__features {
      padding-left: var(--space-6);
      border-left: var(--rule-hair) solid var(--rule);
    }

    /* The side column is held to the lead story's height and scrolls
       inside (see LatestList.astro). This box is what it fills. The
       minimum height keeps it usable beside a short lead. */
    .front__latest {
      grid-area: latest;
      position: relative;
      min-height: 30rem;
    }
    .front__features { grid-area: features; }
  }

  .edition-empty {
    max-width: var(--measure);
    margin: var(--space-6) auto;
    font-size: var(--text-lg);
    font-style: italic;
    text-align: center;
    color: var(--ink-soft);
  }
</style>
