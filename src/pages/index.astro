---
// The front page: the lead story, then everything else, newest first.
// The comic, recurring features and newsletter signup join it later.
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import ArticleList from '../components/ArticleList.astro';
import { getPublishedArticles, summarize } from '../lib/articles';

const articles = await getPublishedArticles();

// The lead is the newest article marked "featured"; failing that, the
// newest article of any kind.
const leadArticle = articles.find((a) => a.data.featured) ?? articles[0];
const lead = leadArticle && (await summarize(leadArticle));
const rest = await Promise.all(articles.filter((a) => a !== leadArticle).map(summarize));
const restItems = rest.map(({ sectionHref, date, ...card }) => card);
---

<BaseLayout mastheadAs="h1">
  {
    lead ? (
      <>
        <LeadStory {...lead} highlighted />

        {restItems.length > 0 && (
          <section class="latest" aria-labelledby="latest-heading">
            <hr class="rule--thick-thin" />
            <h2 id="latest-heading" class="latest__heading">Also in This Edition</h2>
            <ArticleList items={restItems} />
          </section>
        )}
      </>
    ) : (
      <p class="edition-empty">
        The first edition is delayed by circumstances entirely within our control. The
        presses are warm, and the news has been asked to wait in the corridor.
      </p>
    )
  }
</BaseLayout>

<style>
  .latest {
    margin-top: var(--space-7);
  }

  .latest__heading {
    margin: var(--space-4) 0 var(--space-5);
    font-family: var(--font-label);
    font-size: var(--text-lg);
    letter-spacing: 0.12em;
    text-align: center;
  }

  .edition-empty {
    max-width: var(--measure);
    margin: var(--space-6) auto;
    font-size: var(--text-lg);
    font-style: italic;
    text-align: center;
    color: var(--ink-soft);
  }
</style>
