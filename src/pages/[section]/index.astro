---
// The first page of a section front, at /politics, /culture and so on.
// The layout itself is in src/components/SectionFront.astro; later
// pages, when a section has enough articles to need them, are made by
// src/pages/[section]/page/[page].astro.
//
// One page is built for every section in sections.ts, whether or not
// anything has been filed under it yet.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionFront from '../../components/SectionFront.astro';
import { sections } from '../../data/sections';
import type { Section } from '../../lib/section-front';

export function getStaticPaths() {
  // Games has its own page, the hub at src/pages/games/index.astro.
  return sections
    .filter((section) => section.slug !== 'games')
    .map((section) => ({ params: { section: section.slug }, props: { section } }));
}

interface Props {
  section: Section;
}

const { section } = Astro.props;
---

<BaseLayout title={section.name} description={section.blurb}>
  <SectionFront section={section} />
</BaseLayout>
