---
// A section front, at /politics, /culture and so on: the section's name
// and its articles as small illustrated cards, three to a row.
//
// One page is built for every section in sections.ts, whether or not
// anything has been filed under it yet.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { sections } from '../../data/sections';
import { getPublishedArticles, summarize } from '../../lib/articles';

export function getStaticPaths() {
  // Games has its own page, the hub at src/pages/games/index.astro.
  return sections
    .filter((section) => section.slug !== 'games')
    .map((section) => ({ params: { section: section.slug }, props: { section } }));
}

interface Props {
  section: (typeof sections)[number];
}

const { section } = Astro.props;

// Newest first. On the section's own page the cards need no section label.
const filed = (await getPublishedArticles()).filter((a) => a.data.section === section.slug);
const items = (await Promise.all(filed.map(summarize))).map(({ sectionName, sectionHref, date, ...card }) => card);
---

<BaseLayout title={section.name} description={section.blurb}>
  <header class="front-header">
    <p class="label label--accent">Section</p>
    <h1>{section.name}</h1>
    <p class="dek front-header__blurb">{section.blurb}</p>
  </header>

  <hr class="rule--thick-thin" />

  {
    items.length > 0 ? (
      <ArticleList items={items} />
    ) : (
      <p class="front-empty">
        Nothing has yet been filed under {section.name}. The desk has been staffed, the
        pencils sharpened, and the first deadline extended as a courtesy.
      </p>
    )
  }
</BaseLayout>

<style>
  .front-header {
    text-align: center;
  }

  .front-header__blurb {
    max-width: 36rem;
    margin-inline: auto;
  }

  .front-empty {
    max-width: var(--measure);
    margin: var(--space-6) auto;
    font-size: var(--text-lg);
    font-style: italic;
    text-align: center;
    color: var(--ink-soft);
  }
</style>
