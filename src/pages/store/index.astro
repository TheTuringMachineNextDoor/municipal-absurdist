---
// The Store's front page, at /store. Modelled on the shop of The Public
// Domain Review: not a wall of products, but a few large cards, one for
// each part of the shop, each saying what is there and from what price.
//
//   The Art Shop    /store/art     prints, by artist, and commissions
//   The Merch Shop  /store/merch   pins, T-shirts, totes, notebooks, mugs
//
// Products are Markdown files in src/content/products. Buying happens on
// Stripe (each product links to its own Payment Link); there is no cart.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContributors } from '../../lib/contributors';
import { getIllustration, illustrationSrc } from '../../lib/illustrations';
import { fromPrice, getProducts, MERCH } from '../../lib/store';

const products = await getProducts();
const prints = products.filter((p) => p.product.data.kind === 'print');
const merch = MERCH.map((shelf) => ({
  ...shelf,
  items: products.filter((p) => p.product.data.kind === 'merchandise' && p.product.data.category === shelf.id),
}));

// Three prints fanned out on the Art Shop's card. Prints by the paper's
// own artists are shown before prints from the archives.
const fan = [...prints.filter((p) => p.artist), ...prints.filter((p) => !p.artist)]
  .slice(0, 3)
  .map((p) => getIllustration(p.product.data.image));

const artistsForHire = (await getContributors()).filter((c) => c.person.data.commissionsOpen).length;
---

<BaseLayout
  title="The Store"
  description="Art prints, commissions and goods from the artists and writers of The Municipal Absurdist."
>
  <header class="store-header">
    <p class="label label--accent">The Store</p>
    <h1>Shop</h1>
    <p class="dek store-header__dek">
      Everything here was made by someone. The money goes to them and to the paper, in that order where
      possible.
    </p>
  </header>

  <hr class="rule--thick-thin" />

  <section class="shop" aria-labelledby="art-heading">
    <h2 id="art-heading" class="shop__heading">The Art Shop</h2>
    <div class="shop__row shop__row--art">
      <a class="shop-card shop-card--wide" href="/store/art">
        <div class="shop-card__picture shop-card__picture--fan">
          {
            fan.map((picture) => (
              <Image src={illustrationSrc(picture.file)} alt="" width={picture.width} height={picture.height} loading="eager" />
            ))
          }
        </div>
        <div class="shop-card__words">
          <h3 class="shop-card__title">Art Prints</h3>
          <p class="shop-card__blurb">
            Illustrations and cartoons by the paper’s artists, with curiosities from the archives. A gallery,
            arranged by artist.
          </p>
          <p class="label shop-card__price">{fromPrice(prints)}</p>
        </div>
      </a>

      <a class="shop-card" href="/store/art#artists">
        <div class="shop-card__picture shop-card__picture--text" aria-hidden="true">
          <span>&#x261E;&#xFE0E;</span>
        </div>
        <div class="shop-card__words">
          <h3 class="shop-card__title">Meet the Artists</h3>
          <p class="shop-card__blurb">
            Who drew what, and how to hire them for a caricature, a portrait, or an illustration of your own.
          </p>
          <p class="label shop-card__price">
            {
              artistsForHire > 0
                ? `${artistsForHire} ${artistsForHire === 1 ? 'artist is' : 'artists are'} taking commissions`
                : 'Commissions open shortly'
            }
          </p>
        </div>
      </a>
    </div>
  </section>

  <section class="shop" aria-labelledby="merch-heading">
    <h2 id="merch-heading" class="shop__heading">The Merch Shop</h2>
    <div class="shop__row shop__row--merch">
      {
        merch.map((shelf) => {
          const first = shelf.items[0] && getIllustration(shelf.items[0].product.data.image);
          return (
            <a class="shop-card" href={`/store/merch#${shelf.id}`}>
              <div class="shop-card__picture">
                {first && <Image src={illustrationSrc(first.file)} alt="" width={first.width} height={first.height} loading="lazy" />}
              </div>
              <div class="shop-card__words">
                <h3 class="shop-card__title">{shelf.name}</h3>
                <p class="shop-card__blurb">{shelf.blurb}</p>
                <p class="label shop-card__price">{fromPrice(shelf.items)}</p>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="store-terms" aria-labelledby="terms-heading">
    <h2 id="terms-heading" class="label store-terms__heading">How Buying Works</h2>
    <ul class="list-ornament">
      <li>
        Payment is taken by Stripe, on Stripe’s own page. This newspaper never sees your card, and would not
        know what to do with it.
      </li>
      <li>There is no basket. Each item is bought on its own, which the editors find restful.</li>
      <li>A commission is arranged with the artist directly, through the form on their page.</li>
    </ul>
  </section>

</BaseLayout>

<style>
  .store-header {
    text-align: center;
  }

  .store-header__dek {
    max-width: 38rem;
    margin-inline: auto;
  }

  .shop {
    margin-top: var(--space-7);
  }

  /* A ruled label, like the section bands on the front page. */
  .shop__heading {
    margin: 0 0 var(--space-5);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-thick) double var(--rule);
    font-family: var(--font-label);
    font-size: var(--text-lg);
    letter-spacing: 0.12em;
  }

  .shop__row {
    display: grid;
    gap: var(--space-5);
  }

  /* Art: the prints card takes two-thirds, the artists card one-third.
     Merch: two across on a phone, then three, then all five in a row. */
  .shop__row--merch {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 40rem) {
    .shop__row--merch {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 52rem) {
    .shop__row--art {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .shop__row--merch {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* A card is one large link: picture on a tinted mount, then a title,
     a line about it, and the price it starts from. */
  .shop-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .shop-card__picture {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: var(--space-4);
    border: var(--rule-hair) solid var(--rule);
    background: color-mix(in srgb, var(--accent) 10%, var(--paper));
    transition: background 150ms;
  }

  .shop-card:hover .shop-card__picture {
    background: color-mix(in srgb, var(--accent) 28%, var(--paper));
  }

  .shop-card__picture img {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply; /* a white ground takes the mount's colour */
  }

  /* The Art Shop's card: wider than it is tall, with three prints
     side by side, the outer two tilted like pictures leaning on a wall. */
  .shop-card--wide .shop-card__picture {
    aspect-ratio: auto;
    min-height: 16rem;
  }

  .shop-card__picture--fan {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: center;
  }

  .shop-card__picture--fan img {
    width: 100%;
    max-height: 18rem;
    border: var(--rule-hair) solid var(--rule);
    mix-blend-mode: normal;
  }

  .shop-card__picture--fan img:first-child { transform: rotate(-3deg); }
  .shop-card__picture--fan img:last-child { transform: rotate(3deg); }

  /* A card with no picture: a printer's hand, set large. */
  .shop-card__picture--text {
    aspect-ratio: auto;
    min-height: 16rem;
    font-size: 5rem;
    line-height: 1;
    color: var(--accent-text);
  }

  .shop-card__words {
    padding-top: var(--space-3);
  }

  .shop-card__title {
    margin-bottom: var(--space-1);
    font-size: var(--text-h4);
  }

  .shop-card:hover .shop-card__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .shop-card__blurb {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

  .shop-card__price {
    margin: 0;
    font-size: var(--text-sm);
    font-variant-numeric: lining-nums;
    color: var(--accent-text);
  }

  .store-terms {
    max-width: var(--measure-article);
    margin: var(--space-8) auto 0;
    padding-top: var(--space-4);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .store-terms__heading {
    margin-bottom: var(--space-3);
    font-size: var(--text-base);
    text-align: center;
  }

</style>
