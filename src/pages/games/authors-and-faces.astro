---
// Authors & Faces: match a writer to their face, their name, or
// something they wrote, in every direction. Eight questions a day.
//
// Each question shows one thing (a portrait, a name, or a quotation)
// and offers four of another kind to choose from. So one question might
// show a face and ask for the name; the next might show a line and ask
// for the face. The writers are in src/data/authors-and-faces.ts; every
// portrait is in the public domain.
import GameLayout from '../../layouts/GameLayout.astro';
import ResultsCard from '../../components/games/ResultsCard.astro';
import { authors, CHOICES, ROUND_LENGTH } from '../../data/authors-and-faces';
import { getIllustration } from '../../lib/illustrations';

const developing = import.meta.env.DEV;

// Each portrait's credit, looked up here while the page is built and
// handed to the script below as a small block of data. (This also stops
// the build if a portrait has no entry in credits.json.)
const portraitCredits = Object.fromEntries(
  authors.map((author) => [author.id, getIllustration(`authors/${author.id}.webp`).credit]),
);
---

<GameLayout
  title="Authors & Faces"
  standfirst="Match the great writer to the face, the name, or the famous line. All are long dead and unable to object."
>
  <Fragment slot="rules">
    <ul class="list-ornament">
      <li>There are {ROUND_LENGTH} questions. Each shows you a portrait, a name, or a line a writer wrote.</li>
      <li>
        You are then offered {CHOICES} answers of another kind: names, portraits, or lines. Pick the one
        that belongs to the same writer.
      </li>
      <li>Click an answer, or press its number on the keyboard.</li>
      <li>The writer is then named, with their line, where it comes from, and the credit for any portrait shown.</li>
      <li>One round a day, the same for every reader. A new one is printed at midnight, Central time.</li>
    </ul>
  </Fragment>

  <script type="application/json" data-af-credits set:html={JSON.stringify(portraitCredits)} />

  <div class="af" data-af>
    <p class="label af__progress" data-af-progress>Question 1 of {ROUND_LENGTH}</p>

    <!-- What is shown: one of these three, the other two hidden.
         A portrait's alt text stays general until the reader answers,
         so that it does not give the answer away. -->
    <div class="af__prompt">
      <img class="af__portrait" data-af-prompt="face" alt="Portrait of a writer" width="480" height="600" hidden />
      <p class="af__prompt-name" data-af-prompt="name" hidden></p>
      <blockquote class="af__prompt-quote" data-af-prompt="quote" hidden></blockquote>
    </div>

    <!-- tabindex="-1": focus moves here when a new question appears. -->
    <h2 class="af__question" data-af-question tabindex="-1"></h2>

    <!-- The four answers are put here by the script. -->
    <ol class="af__choices" data-af-choices></ol>

    <div class="af__verdict" data-af-verdict hidden>
      <p class="af__outcome" data-af-outcome></p>
      <p class="af__name" data-af-answer></p>
      <p class="af__line" data-af-line></p>
      <p class="af__quoted" data-af-quoted></p>
      <p class="fine-print af__credit" data-af-credit></p>
    </div>
    <button type="button" class="af__next" data-af-next hidden>Next question</button>

    <p class="visually-hidden" role="status" data-af-live></p>
  </div>

  <ResultsCard>
    {
      developing && (
        <button type="button" class="af__replay" data-af-replay>Play again (development only)</button>
      )
    }
  </ResultsCard>
</GameLayout>

<script>
  import { authors, CHOICES, ROUND_LENGTH, type Author } from '../../data/authors-and-faces';
  import { chicagoDateKey, dayNumber, formatDateKey, seededShuffle } from '../../lib/games/daily';
  import { readStats, recordResult } from '../../lib/games/stats';
  import { showResults } from '../../lib/games/results';

  const GAME_ID = 'authors-and-faces';

  // The three things a writer can be known by.
  type Kind = 'face' | 'name' | 'quote';

  // Every way of asking: what is shown, and what the answers are.
  const FORMS: { show: Kind; pick: Kind; ask: (author: Author) => string }[] = [
    { show: 'face', pick: 'name', ask: () => 'Who is this?' },
    { show: 'name', pick: 'face', ask: (a) => `Which of these is ${a.name}?` },
    { show: 'quote', pick: 'name', ask: () => 'Who wrote this?' },
    { show: 'quote', pick: 'face', ask: () => 'Which of these writers wrote this?' },
    { show: 'face', pick: 'quote', ask: () => 'Which of these did this writer write?' },
    { show: 'name', pick: 'quote', ask: (a) => `Which of these did ${a.name} write?` },
  ];

  // Ranks, from the bottom. `from` is the lowest number right (out of 8).
  const RANKS = [
    { from: 0, name: 'Has Not Done the Reading', blurb: 'The faces meant nothing to you. In fairness, most of them never met you either.' },
    { from: 3, name: 'Judges Books by Their Covers', blurb: 'You went by the beards. It is a method, and it has limits.' },
    { from: 5, name: 'Well-Thumbed', blurb: 'A respectable showing. You have clearly been in a library, possibly on purpose.' },
    { from: 7, name: 'Assistant Librarian', blurb: 'One escaped you. It will be on your mind for the rest of the day.' },
    { from: 8, name: 'Keeper of the Portraits', blurb: 'A perfect round. The dead are flattered and have asked that you stop staring.' },
  ];
  const rankFor = (score: number, outOf: number) => {
    const scaled = outOf > 0 ? (score / outOf) * 8 : 0;
    return [...RANKS].reverse().find((rank) => scaled >= rank.from) ?? RANKS[0];
  };

  // The credits were written into the page when it was built.
  const credits: Record<string, string> = JSON.parse(
    document.querySelector('[data-af-credits]')?.textContent ?? '{}',
  );
  const portraitSrc = (author: Author) => `/illustrations/authors/${author.id}.webp`;

  // Today's round: eight writers, the form each question takes, and the
  // three wrong answers offered beside the right one. All seeded with
  // the date, so every reader gets the same questions. The forms are
  // dealt from a shuffled pack, so a round always has a mix.
  function buildRound(dateKey: string) {
    const seed = dayNumber(dateKey);
    const pack = seededShuffle(FORMS, seed + 50);
    return seededShuffle(authors, seed)
      .slice(0, ROUND_LENGTH)
      .map((author, index) => {
        const others = seededShuffle(authors.filter((a) => a.id !== author.id), seed + 100 + index).slice(0, CHOICES - 1);
        return {
          author,
          form: pack[index % pack.length],
          choices: seededShuffle([author, ...others], seed + 200 + index),
        };
      });
  }

  const root = document.querySelector<HTMLElement>('[data-af]');
  const resultsCard = document.querySelector<HTMLElement>('[data-results]');
  if (root && resultsCard) play(root, resultsCard);

  function play(root: HTMLElement, resultsCard: HTMLElement) {
    const find = <T extends HTMLElement>(hook: string) => root.querySelector<T>(`[data-af-${hook}]`)!;
    const progress = find('progress');
    const prompts = {
      face: root.querySelector<HTMLImageElement>('[data-af-prompt="face"]')!,
      name: root.querySelector<HTMLElement>('[data-af-prompt="name"]')!,
      quote: root.querySelector<HTMLElement>('[data-af-prompt="quote"]')!,
    };
    const question = find('question');
    const choicesList = find('choices');
    const verdict = find('verdict');
    const outcome = find('outcome');
    const answerEl = find('answer');
    const line = find('line');
    const quoted = find('quoted');
    const credit = find('credit');
    const nextButton = find<HTMLButtonElement>('next');
    const live = find('live');

    const today = chicagoDateKey();
    const yesterday = chicagoDateKey(new Date(Date.now() - 86_400_000));
    const round = buildRound(today);

    let index = 0;
    let marks: boolean[] = [];
    let answering = true;
    let buttons: HTMLButtonElement[] = [];

    function reveal(stats = readStats(GAME_ID), result = { score: 0, marks: [] as boolean[] }) {
      const outOf = result.marks.length;
      const rank = rankFor(result.score, outOf);
      root.hidden = true;
      showResults(resultsCard, {
        score: `${result.score} out of ${outOf}`,
        rank: rank.name,
        blurb: rank.blurb,
        shareText: [
          `Authors & Faces, ${formatDateKey(today)}`,
          `${result.score}/${outOf} · ${rank.name}`,
          result.marks.map((right) => (right ? '■' : '□')).join(''),
          `${location.origin}${location.pathname}`,
        ].join('\n'),
        stats,
        note: 'A fresh round is printed at midnight, Central time.',
      });
    }

    /** One answer button: a name, a quotation, or a portrait. */
    function makeChoice(choice: Author, kind: Kind, number: number): HTMLButtonElement {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `af__choice af__choice--${kind}`;
      button.dataset.afChoice = choice.id;

      const badge = document.createElement('span');
      badge.className = 'af__number';
      badge.setAttribute('aria-hidden', 'true');
      badge.textContent = String(number);
      button.append(badge);

      if (kind === 'face') {
        const image = document.createElement('img');
        image.src = portraitSrc(choice);
        image.alt = `Portrait ${number}`; // named once the reader has answered
        image.width = 480;
        image.height = 600;
        const caption = document.createElement('span');
        caption.className = 'af__caption';
        button.append(image, caption);
      } else {
        const text = document.createElement('span');
        text.className = 'af__text';
        text.textContent = kind === 'name' ? choice.name : `“${choice.quote}”`;
        button.append(text);
      }

      button.addEventListener('click', () => answer(choice.id));
      return button;
    }

    function deal() {
      const { author, form, choices } = round[index];
      answering = true;
      progress.textContent = `Question ${index + 1} of ${round.length}`;

      // Show the one thing this question shows; hide the other two.
      for (const [kind, element] of Object.entries(prompts)) element.hidden = kind !== form.show;
      if (form.show === 'face') {
        prompts.face.src = portraitSrc(author);
        prompts.face.alt = 'Portrait of a writer';
      } else if (form.show === 'name') {
        prompts.name.textContent = author.name;
      } else {
        prompts.quote.textContent = `“${author.quote}”`;
      }

      question.textContent = form.ask(author);

      buttons = choices.map((choice, i) => makeChoice(choice, form.pick, i + 1));
      choicesList.className = `af__choices af__choices--${form.pick}`;
      choicesList.replaceChildren(
        ...buttons.map((button) => {
          const item = document.createElement('li');
          item.append(button);
          return item;
        }),
      );

      verdict.hidden = true;
      nextButton.hidden = true;

      // For a screen reader: what is shown, the question, and the answers.
      const shown =
        form.show === 'face' ? 'A portrait of a writer.' : form.show === 'name' ? `${author.name}.` : `“${author.quote}”`;
      const offered = choices
        .map((c, i) => `${i + 1}, ${form.pick === 'face' ? 'a portrait' : form.pick === 'name' ? c.name : c.quote}`)
        .join('. ');
      live.textContent = `Question ${index + 1} of ${round.length}. ${shown} ${form.ask(author)} ${offered}.`;
      if (index > 0) question.focus({ preventScroll: true });
    }

    function answer(id: string) {
      if (!answering) return;
      answering = false;
      const { author, form, choices } = round[index];
      const right = id === author.id;
      marks.push(right);

      // Mark the right answer, and the wrong one if that was picked.
      buttons.forEach((button, i) => {
        button.disabled = true;
        if (button.dataset.afChoice === author.id) button.dataset.state = 'right';
        else if (button.dataset.afChoice === id) button.dataset.state = 'wrong';
        // Now the answer is out, every portrait can be named.
        if (form.pick === 'face') {
          button.querySelector('img')!.alt = `Portrait of ${choices[i].name}`;
          button.querySelector('.af__caption')!.textContent = choices[i].name;
        }
      });
      if (form.show === 'face') prompts.face.alt = `Portrait of ${author.name}`;

      outcome.textContent = right ? 'Correct.' : 'Incorrect.';
      answerEl.textContent = `${author.name} (${author.lived})`;
      line.textContent = author.line;
      quoted.textContent = `“${author.quote}” ${author.quoteFrom}.`;

      // Credit every portrait that was on screen.
      const shownPortraits = form.pick === 'face' ? choices : form.show === 'face' ? [author] : [];
      credit.textContent = shownPortraits.map((a) => credits[a.id] ?? '').join(' ');

      nextButton.textContent = index === round.length - 1 ? 'See the result' : 'Next question';
      verdict.hidden = false;
      nextButton.hidden = false;
      nextButton.focus({ preventScroll: true });
      live.textContent = `${right ? 'Correct.' : 'Incorrect.'} ${author.name}, ${author.lived}. ${author.line}`;
    }

    function next() {
      if (answering) return;
      index += 1;
      if (index < round.length) {
        deal();
        return;
      }
      const result = { score: marks.filter(Boolean).length, marks };
      reveal(recordResult(GAME_ID, today, yesterday, result), result);
    }

    nextButton.addEventListener('click', next);

    // Number keys pick an answer.
    document.addEventListener('keydown', (event) => {
      if (root.hidden || !answering || event.altKey || event.ctrlKey || event.metaKey) return;
      const picked = buttons[Number(event.key) - 1];
      if (picked) {
        event.preventDefault();
        picked.click();
      }
    });

    // Development only: play again without waiting for midnight.
    resultsCard.querySelector('[data-af-replay]')?.addEventListener('click', () => {
      index = 0;
      marks = [];
      resultsCard.hidden = true;
      root.hidden = false;
      deal();
    });

    const saved = readStats(GAME_ID);
    if (saved.lastPlayed === today && saved.lastResult) reveal(saved, saved.lastResult);
    else deal();
  }
</script>

<!-- `is:global` because the answer buttons are made by the script, and
     Astro's scoped styles only reach elements written in this file.
     Every rule starts with .af, so nothing leaks out. -->
<style is:global>
  .af {
    text-align: center;
    --right: #1e5b3c;
    --wrong: #a8321f;
  }

  .af[hidden],
  .af [hidden] {
    display: none;
  }

  .af__progress {
    margin-bottom: var(--space-3);
  }

  .af__prompt {
    margin-bottom: var(--space-4);
  }

  /* A portrait being asked about, in a ruled frame like a picture on a wall. */
  .af__portrait {
    width: min(100%, 15rem);
    margin-inline: auto;
    padding: var(--space-2);
    border: var(--rule-thick) double var(--rule);
    background: var(--paper);
  }

  /* A name being asked about, set like a nameplate. */
  .af__prompt-name {
    display: inline-block;
    margin: 0;
    padding: var(--space-3) var(--space-5);
    border: var(--rule-thick) double var(--rule);
    font-family: var(--font-headline);
    font-size: var(--text-h2);
    font-weight: var(--weight-headline);
    line-height: var(--leading-tight);
  }

  /* A quotation being asked about. */
  .af__prompt-quote {
    margin: 0;
    padding: var(--space-4) var(--space-3);
    border: 0;
    border-block: var(--rule-thick) double var(--rule);
    font-size: var(--text-h4);
    font-style: italic;
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .af__question {
    margin-bottom: var(--space-3);
    font-size: var(--text-h4);
  }

  .af__question:focus {
    outline: none; /* focus is moved here by script, to be read aloud */
  }

  .af__choices {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Names: two across when there is room. Quotations: one per line,
     since they are long. Portraits: two across on a phone, four on a desk. */
  .af__choices--name {
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
  }

  .af__choices--face {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 40rem) {
    .af__choices--face {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .af__choice {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    height: 100%;
    min-height: 3rem;
    padding: var(--space-2) var(--space-3);
    border: var(--rule-hair) solid var(--ink-soft);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    text-align: left;
    cursor: pointer;
  }

  .af__choice--quote {
    font-size: var(--text-base);
    font-style: italic;
  }

  .af__choice:hover:not(:disabled) {
    border-color: var(--ink);
    background: var(--accent);
  }

  .af__choice:disabled {
    cursor: default;
  }

  .af__number {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: var(--rule-hair) solid currentColor;
    background: var(--paper);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-style: normal;
    font-variant-numeric: lining-nums;
  }

  /* A portrait as an answer: the picture fills the button, with its
     number in the corner and, after answering, the name beneath. */
  .af__choice--face {
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-1);
  }

  .af__choice--face img {
    width: 100%;
  }

  .af__choice--face .af__number {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
  }

  .af__caption {
    min-height: 1.3em;
    font-size: var(--text-sm);
    line-height: 1.3;
    text-align: center;
  }

  /* After answering: the right answer gets a thick green frame and the
     word "Right"; a wrong pick gets a red one and the word "Wrong". The
     words mean colour is never the only signal. */
  .af__choice[data-state='right'] {
    outline: 3px solid var(--right);
    outline-offset: -3px;
  }

  .af__choice[data-state='wrong'] {
    outline: 3px solid var(--wrong);
    outline-offset: -3px;
  }

  .af__choice[data-state]::after {
    margin-left: auto;
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-style: normal;
    letter-spacing: 0.1em;
  }

  .af__choice[data-state='right']::after {
    content: 'Right';
    color: var(--right);
  }

  .af__choice[data-state='wrong']::after {
    content: 'Wrong';
    color: var(--wrong);
  }

  .af__choice--face[data-state]::after {
    margin: 0;
  }

  .af__verdict {
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-2);
    border-block: var(--rule-hair) solid var(--rule);
  }

  .af__outcome {
    margin-bottom: var(--space-1);
    font-family: var(--font-label);
    letter-spacing: 0.12em;
    color: var(--accent-text);
  }

  .af__name {
    margin-bottom: var(--space-2);
    font-family: var(--font-headline);
    font-size: var(--text-h3);
    font-weight: var(--weight-headline);
    line-height: var(--leading-snug);
  }

  .af__line {
    max-width: 30rem;
    margin: 0 auto var(--space-3);
    font-style: italic;
    color: var(--ink-soft);
  }

  .af__quoted {
    max-width: 32rem;
    margin: 0 auto;
    font-size: var(--text-sm);
  }

  .af__credit {
    margin: var(--space-3) 0 0;
    font-style: italic;
  }

  .af__credit:empty {
    display: none;
  }

  .af__next {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    margin-top: var(--space-4);
    border: var(--rule-hair) solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-label);
    font-size: var(--text-base);
    letter-spacing: 0.1em;
    cursor: pointer;
  }

  .af__next:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }

  .af__replay {
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: var(--rule-hair) dashed var(--ink-soft);
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
</style>
