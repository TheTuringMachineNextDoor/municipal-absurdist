---
// The games hub at /games: every game as a notice card. The list is
// src/data/games.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameNotice from '../../components/games/GameNotice.astro';
import { games } from '../../data/games';
import { realOrAbsurdistReady } from '../../data/real-or-absurdist';

// Real or Absurdist stays closed to the public until it has enough real
// headlines (see src/data/real-or-absurdist.ts). While developing it is
// always open, so it can be tested.
const isOpen = (game: (typeof games)[number]) =>
  game.live && (game.slug !== 'real-or-absurdist' || realOrAbsurdistReady || import.meta.env.DEV);

---

<BaseLayout
  title="Games"
  description="The Bureau of Amusement: games and puzzles from The Municipal Absurdist."
>
  <header class="hub-header">
    <p class="label label--accent">Bureau of Amusement</p>
    <h1>Games</h1>
    <p class="dek hub-header__blurb">
      Diversions for the idle and the employed alike. The Bureau accepts no responsibility
      for time lost, which was not being put to good use.
    </p>
  </header>

  <hr class="rule--thick-thin" />

  <ul class="hub">
    {
      games.map((game) => (
        <li>
          <GameNotice
            name={game.name}
            blurb={game.blurb}
            image={game.image}
            href={isOpen(game) ? `/games/${game.slug}` : undefined}
          />
        </li>
      ))
    }
  </ul>

</BaseLayout>

<style>
  .hub-header {
    text-align: center;
  }

  .hub-header__blurb {
    max-width: 36rem;
    margin-inline: auto;
  }

  /* As many cards across as fit at 17rem or wider: one on a phone,
     three or four on a desk. */
  .hub {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

</style>
